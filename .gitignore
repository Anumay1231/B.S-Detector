# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/

# Testing
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Project-specific
#
# NOTE on negated subdirectories: gitignore does not recurse into a
# directory that an earlier pattern already excluded, so negating a
# *file* inside an excluded directory (e.g. "!outputs/embeddings/.gitkeep")
# has no effect unless the directory itself is un-excluded first (e.g.
# "!outputs/embeddings/"). Every nested .gitkeep exception below
# un-excludes its directory explicitly for this reason.
outputs/*
!outputs/.gitkeep
data/reference/*
!data/reference/.gitkeep
data/test/*
!data/test/.gitkeep
data/trials/*
!data/trials/.gitkeep

# Downloaded datasets. Anything under data/raw/ is externally obtained
# (VoxCeleb1 audio, trial lists, metadata tables, ...) and must never be
# committed: it is large, redistribution-restricted, and reproducible by
# re-downloading from the official source. This is a directory-level
# exclusion on purpose -- it covers dataset layouts we have not seen yet
# (e.g. data/raw/kathbath/, data/raw/<whatever>/).
data/raw/

# Phase 7: VoxCeleb (and any other large external dataset) -- raw audio,
# metadata, generated trial subsets, and processed artifacts must never
# be committed. Only .gitkeep placeholders are tracked so the directory
# structure itself is documented in Git.
data/voxceleb/raw/*
!data/voxceleb/raw/.gitkeep
data/voxceleb/metadata/*
!data/voxceleb/metadata/.gitkeep
data/voxceleb/trials/*
!data/voxceleb/trials/.gitkeep
data/voxceleb/processed/*
!data/voxceleb/processed/.gitkeep

# Phase 7: generated embeddings, scores, and calibration/evaluation
# reports are large, machine-specific, and reproducible from code +
# data -- they do not belong in Git. These are subdirectories of
# outputs/, which "outputs/*" above already excludes as directories, so
# each one must be explicitly un-excluded before its own "*"/".gitkeep"
# pair will take effect (see NOTE above).
!outputs/embeddings/
outputs/embeddings/*
!outputs/embeddings/.gitkeep
!outputs/scores/
outputs/scores/*
!outputs/scores/.gitkeep
!outputs/calibration/
outputs/calibration/*
!outputs/calibration/.gitkeep
!outputs/evaluation/
outputs/evaluation/*
!outputs/evaluation/.gitkeep

# Common VoxCeleb/dataset archive formats, in case one is ever
# downloaded into a Git-tracked location by mistake.
*.tar
*.tar.gz
*.zip

# Model weights / large artifacts
*.pt
*.pth
*.ckpt
*.bin

# Pretrained model cache (Phase 4+). By default SpeakerEncoder uses the
# Hugging Face Hub's own cache (~/.cache/huggingface/hub), outside this
# repo. These are excluded defensively in case an explicit local savedir
# is ever used.
pretrained_models/
model_cache/

# Local audio test files
tests/recording test/

# Deepfake-detection research (merged from the base branch). The SEA-Spoof
# metadata parquets and the cached waveform/feature tensors are large and
# reproducible from scripts/, so they stay out of Git.
data/*.parquet
data/deepfake_cache/
.eggs/
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root
.mplconfig/

# Web app: the built UI is committed so the app runs with Python alone.
!frontend/dist/
frontend/node_modules/

# playwright-cli session snapshots
.playwright-cli/

# Research (base branch): local checkpoints, LaTeX build files, paper drafts
models/*.pth
!models/sls_head_silence_invariant.pth
!models/sls_head_n500_indicsynth_best.pth
!models/sls_head_phase12.pth
!models/ecapa_indian_adapted.pth
!outputs/indicsynth_results.json
!outputs/sls_robust_results.json
!outputs/sls_channel_robust_results.json
*.aux
*.log
*.out
*.toc
missfont.log
paper/

models/*.part

# Consented real-world recordings (docs/recording-protocol.md): private, never commit
data/real_recordings/

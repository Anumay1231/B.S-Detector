# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/

# Testing
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Project-specific
outputs/*
!outputs/.gitkeep
data/reference/*
!data/reference/.gitkeep
data/test/*
!data/test/.gitkeep
data/trials/*
!data/trials/.gitkeep

# Model weights / large artifacts
*.pt
*.pth
*.ckpt
*.bin

# Pretrained model cache (Phase 4+). By default SpeakerEncoder uses the
# Hugging Face Hub's own cache (~/.cache/huggingface/hub), outside this
# repo. These are excluded defensively in case an explicit local savedir
# is ever used.
pretrained_models/
model_cache/

# Local audio test files
tests/recording test/
